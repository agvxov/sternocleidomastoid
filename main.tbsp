%top{
    #include <stdio.h>
    #include <stdlib.h>
    #include <pthread.h>
    #include <unistd.h>
    #include <tcl.h>
    #include <tk.h>
    #include <slurp.h>
    #include <sds.h>
    #include <hstack.h>

    // XXX
    // cheap hack until tbsp supports nesting
    // that is, until i finish fstring
    enum {
        NONE,
        HEADING,
        QUOTE,
        LIST,
        CODE,
    } parent_node_type = NONE;
    int heading_level = 1;

    sds script_buffer;

    #define TCL_ARGS ClientData clientData, Tcl_Interp *interp, int argc, const char **argv
    #define TCL_EASY_CREATE_COMMAND(c) \
        Tcl_CreateCommand(interp, #c, Tcl_ ## c, (ClientData)NULL, (void (*)(void*))NULL);

    #define ECHO(fmt, ...) script_buffer = sdscatprintf(script_buffer, fmt "\n" __VA_OPT__(,) __VA_ARGS__)
    #define ECHOV(v)       script_buffer = sdscat(script_buffer, v)

    hstack_t(int, 8) md_list_stack;
    enum {
        NUMBER,
        STAR,
        PLUS,
        MINUS,
    } md_list_element_type;

    /* Since we can't just use tbsp normally to handle inline constructs:
        > To use the two grammars, first parse the document with the block grammar.
        > Then perform a second parse with the inline grammar
        > using ts_parser_set_included_ranges to specify which parts are inline content.
        > These parts are marked as inline nodes.
    */
    static
    void parse_inline(const char * const input) {
      #define FLUSH do {\
            if (!sdslen(r)) { break; }                                         \
            command = sdscatprintf(command, "append_text {%s} {", r);          \
            if (is_bold && is_italic) {                                        \
                command = sdscat(command, "bolditalic ");                      \
            } else                                                             \
            if (is_bold) {                                                     \
                command = sdscat(command, "bold ");                            \
            } else                                                             \
            if (is_italic) {                                                   \
                command = sdscat(command, "italic ");                          \
            }                                                                  \
                                                                               \
            if (is_strike) {                                                   \
                command = sdscat(command, "strike ");                          \
            }                                                                  \
                                                                               \
            command = sdscat(command, "}\n");                                  \
                                                                               \
            ECHOV(command);                                                    \
            sdsclear(command);                                                 \
            sdsclear(r);                                                       \
        } while (0)
        const char * quote       = "^\\s*>";
        const char * code        = "`(.*?)`";
        const char * inlink      = "\\[(.*?)\\]\\(#(.*?)\\)";
        const char * outlink     = "\\[(.*?)\\]\\((.*?)\\)";

        sds r       = sdsnew("");
        sds command = sdsnew("");

        bool is_bold   = false;
        bool is_italic = false;
        bool is_strike = false;

        enum {
            INITIAL,
            IN_POSSIBLE_LINK_TITLE,
        } state = INITIAL;
        sds alt     = sdsnew("");
        sds dest    = sdsnew("");

        for (const char * s = input; *s != '\0'; s++) {
            switch (*s) {
                case '*': case '_': {
                    FLUSH;

                    char c = *s;
                    if (s[1] == c) {
                        is_bold = !is_bold;
                    } else {
                        is_italic = !is_italic;
                    }
                } break;
                case '~': {
                    if (s[1] == '~'
                    &&  s[2] == '~') {
                        FLUSH;

                        is_strike = !is_strike;
                    }
                }
                case '[': {
                    state = IN_POSSIBLE_LINK_TITLE;
                } break;
                case '\\': {
                    if (s[1] != '\0') {
                        ++s;
                    }
                } break;
                case '\n': {
                    r = sdscatlen(r, " ", 1);
                } break;
                default: {
                    r = sdscatlen(r, s, 1);
                } break;
            }
        }
        FLUSH;

      #undef FLUSH
    }
}
%language markdown
%%

leave document {
    ECHO("finalize_document");
}

leave paragraph {
    if (!hs_size(md_list_stack)) {
        ECHO("paragraph_end");
    }
}

// --- Text of any kind
enter inline {
    char * t = tbget_text;

    switch (parent_node_type) {
        case NONE: {
            parse_inline(t);
        } break;
        case HEADING: {
            ECHO("header %d {%s}", heading_level, t);
        } break;
        case QUOTE: {
            ECHO("quote {%s}", t);
        } break;
        case LIST: {
            char prefix[8] = {0};
            switch (md_list_element_type) {
                case NUMBER: {
                    sprintf(prefix, "%d.", hs_top(md_list_stack)++);
                } break;
                case STAR: {
                    prefix[0] = '*';
                } break;
                case MINUS: {
                    prefix[0] = '-';
                } break;
                case PLUS: {
                    prefix[0] = '+';
                } break;
            }
            ECHO("list_item %ld {%s %s}", hs_size(md_list_stack), prefix, t);
        } break;
        case CODE: {
            ECHO("code {%s}", t);
        } break;
    }

    free(t);
}

// --- Headings
enter atx_heading {
    parent_node_type = HEADING;
}

leave atx_heading {
    parent_node_type = NONE;
}

enter atx_h1_marker {
    heading_level = 1;
}

enter atx_h2_marker {
    heading_level = 2;
}

enter atx_h3_marker {
    heading_level = 3;
}

// --- Quotes ---
enter block_quote {
    parent_node_type = QUOTE;
}

leave block_quote {
    parent_node_type = NONE;
}

// --- Lists ---
enter list {
    parent_node_type = LIST;
    hs_push(md_list_stack, 1);
}

leave list {
    (void)hs_pop(md_list_stack);

    if (!hs_size(md_list_stack)) {
        parent_node_type = NONE;
        ECHO("paragraph_end");
    }
}

enter list_marker_star {
    md_list_element_type = STAR;
}

enter list_marker_plus {
    md_list_element_type = PLUS;
}

enter list_marker_minus {
    md_list_element_type = MINUS;
}

enter list_marker_dot {
    md_list_element_type = NUMBER;
}

// --- Horizontal Line ---
enter thematic_break {
    ECHO("horizontal_line");
}


// --- Code ---
enter code_fence_content indented_code_block {
    parent_node_type = CODE;
}

leave code_fence_content indented_code_block {
    parent_node_type = CODE;
}

