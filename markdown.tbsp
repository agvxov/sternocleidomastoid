%top{
    #include <stdio.h>
    #include <stdlib.h>
    #include <unistd.h>
    #include <sds.h>
    #include <hstack.h>
    #include "global.h"

    extern int iltraverse(const char * const tbcode);
    extern sds script_buffer;

    // XXX
    // cheap hack until tbsp supports nesting
    // that is, until i finish fstring
    enum {
        NONE,
        HEADING,
        QUOTE,
        LIST,
        CODE,
    } parent_node_type = NONE;
    int heading_level = 1;

    hstack_t(int, 8) md_list_stack;
    enum {
        NUMBER,
        STAR,
        PLUS,
        MINUS,
    } md_list_element_type;
}
%language markdown
%%

leave document {
    ECHO("finalize_document");
}

leave paragraph {
    if (!hs_size(md_list_stack)) {
        ECHO("paragraph_end");
    }
}

// --- Text of any kind
enter inline {
    char * t = tbget_text;

    switch (parent_node_type) {
        case NONE: {
            iltraverse(t);
        } break;
        case HEADING: {
            ECHO("header %d {%s}", heading_level, t);
        } break;
        case QUOTE: {
            int last_line_start = 0;
            for (const char * s = t; true; s++) {
                if (*s == '\n'
                ||  *s == '\0') {
                    ECHO("quote {%.*s}", s - (t + last_line_start), t + last_line_start);
                    last_line_start = (s - t) + 1;
                }
                if (!*s) {
                    break;
                }
            }
        } break;
        case LIST: {
            char prefix[8] = {0};
            switch (md_list_element_type) {
                case NUMBER: {
                    sprintf(prefix, "%d.", hs_top(md_list_stack)++);
                } break;
                case STAR: {
                    prefix[0] = '*';
                } break;
                case MINUS: {
                    prefix[0] = '-';
                } break;
                case PLUS: {
                    prefix[0] = '+';
                } break;
            }
            ECHO("list_item %ld {%s %s}", hs_size(md_list_stack), prefix, t);
        } break;
        case CODE: {
            ECHO("code {%s}", t);
        } break;
    }

    free(t);
}

// --- Headings
enter atx_heading {
    parent_node_type = HEADING;
}

leave atx_heading {
    parent_node_type = NONE;
}

enter atx_h1_marker {
    heading_level = 1;
}

enter atx_h2_marker {
    heading_level = 2;
}

enter atx_h3_marker {
    heading_level = 3;
}

// --- Quotes ---
enter block_quote {
    parent_node_type = QUOTE;
}

leave block_quote {
    parent_node_type = NONE;
}

// --- Lists ---
enter list {
    parent_node_type = LIST;
    hs_push(md_list_stack, 1);
}

leave list {
    (void)hs_pop(md_list_stack);

    if (!hs_size(md_list_stack)) {
        parent_node_type = NONE;
        ECHO("paragraph_end");
    }
}

enter list_marker_star {
    md_list_element_type = STAR;
}

enter list_marker_plus {
    md_list_element_type = PLUS;
}

enter list_marker_minus {
    md_list_element_type = MINUS;
}

enter list_marker_dot {
    md_list_element_type = NUMBER;
}

// --- Horizontal Line ---
enter thematic_break {
    ECHO("horizontal_line");
}


// --- Code ---
enter code_fence_content indented_code_block {
    parent_node_type = CODE;
}

leave code_fence_content indented_code_block {
    parent_node_type = NONE;
}

