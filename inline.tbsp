%top{
    #include "global.h"
    #include "slurp.h"

    #ifdef INLINE_MAIN
        #undef ECHO
        #define ECHO(fmt, ...) printf(fmt "\n" __VA_OPT__(,) __VA_ARGS__)
    #endif

    /* # Tree-sitter-markdown-inline is horrifying
     * The problem is that it was "designed for highlighting" and "ts is restrictive",
     *  ie, a retard wrote it. As of 2025, there is no good MD parser on the face of
     *  the planet, which is partially due to the spec being finicky.
     *
     * One problem is, that there are no raw-text nodes.
     * They simply do not exist.
     * To get regular text protions, one has to juggle begining and ending positions
     *  of formatted text notes, e.g. "did we skip between this italic and this bold?"
     *
     * The second problem is `*` and `**` combining instead of it being its own node.
     * I do not think anyone ever wrote "*This is my bloog, **enjoy!***",
     *  still its something that is legal.
     *
     * `***t***` is always parsed as:
     *    (emphasis
     *        (emphasis_delimiter)
     *        (strong_emphasis
     *            (emphasis_delimiter)
     *            (emphasis_delimiter)
     *            (emphasis_delimiter)
     *            (emphasis_delimiter))
     *        (emphasis_delimiter))
     * On which we depend as a special case. All other combinations can fuck themselves.
     *
     * Conclusion: I will have to write a markdown parser one day.
     */
    static int last_end_pos = 0;

    #define FLUSH flush(tbnode, tbcode)
    void flush(TSNode n, const char * const s) {
        int start = ts_node_start_byte(n);
        int end   = ts_node_end_byte(n);

        //printf("%d %d %d\n", last_end_pos, start, end);

        if (start != last_end_pos) {
            ECHO("append_text {%.*s} {}", start - last_end_pos, s+last_end_pos);
        }

        last_end_pos = end;
    }
}
%language markdown_inline
%%
enter emphasis {
    FLUSH;
    char * t = tbget_text;
    ECHO("append_text {%s} {italic}", t);
    free(t);

}

enter strong_emphasis {
    FLUSH;
    char * t = tbget_text;
    ECHO("append_text {%s} {bold}", t);
    free(t);
}

enter code_span {
    FLUSH;
    char * t = tbget_text;
    ECHO("append_text {%s} {code}", t);
    free(t);
}

leave inline {
    // XXX
    auto n = tbnode;
    int end   = ts_node_end_byte(n);

    if (end != last_end_pos) {
        ECHO("append_text {%.*s} {}", end - last_end_pos, tbcode+last_end_pos);
    }

    last_end_pos = 0;
}
%%

#ifdef INLINE_MAIN
/* @BAKE
    ./tbsp --prefix il -o $@.c $@
    gcc -Ilibrary -DINLINE_MAIN -D_GNU_SOURCE -o $*.out $@.c -ltree-sitter -ltree-sitter-markdown-inline -ggdb
   @STOP
*/
signed main(int argc, char * argv[]) {
    const char * in_file = NULL;
    char * in_str = slurp(argv[1]);
    iltraverse(in_str);

    return 0;
}
#endif
